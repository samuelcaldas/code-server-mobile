+	background: var(--vscode-sideBar-background) !important;
+	border-right: none !important;
+	border-left: none !important;
+	z-index: 2522 !important;
+}
+
+/* Auxiliary Bar Part (Copilot / AI Chat / Secondary Sidebar) */
+.monaco-workbench.phone-layout .part.auxiliarybar,
+.monaco-workbench.phone-layout.noauxiliarybar .part.auxiliarybar.mobile-navigation-overlay--auxiliarybar,
+.monaco-workbench.phone-layout .part.auxiliarybar.mobile-navigation-overlay--auxiliarybar {
+	display: block !important;
+	visibility: visible !important;
+	width: 100% !important;
+	width: 100vw !important;
+	max-width: 100% !important;
+	left: 0 !important;
+	right: 0 !important;
+	background: var(--vscode-sideBar-background) !important;
+	border-left: none !important;
+	z-index: 2522 !important;
+}
+
+/* Bottom Panel Part (Terminal / Output) */
+.monaco-workbench.phone-layout .part.panel,
+.monaco-workbench.phone-layout.nopanel .part.panel.mobile-navigation-overlay--panel,
+.monaco-workbench.phone-layout .part.panel.mobile-navigation-overlay--panel {
+	display: block !important;
+	visibility: visible !important;
+	width: 100% !important;
+	width: 100vw !important;
+	max-width: 100% !important;
+	left: 0 !important;
