+/* ---- Phone Layout: Small Screen Decluttering ---- */
+
+/* 1. Hide Minimap and split sashes on smartphone screens */
+.monaco-workbench.phone-layout .minimap {
+	display: none !important;
+}
+
+.monaco-workbench.phone-layout .monaco-sash,
+.monaco-workbench.phone-layout .monaco-split-view2 > .sash-container {
+	display: none !important;
+	pointer-events: none !important;
+}
+
+/* 2. Hide split editor actions & desktop layout controls */
+.monaco-workbench.phone-layout .editor-actions .action-item:has(.codicon-split-horizontal),
+.monaco-workbench.phone-layout .editor-actions .action-item:has(.codicon-split-vertical),
+.monaco-workbench.phone-layout .editor-actions .action-item:has(.codicon-unlock),
+.monaco-workbench.phone-layout .editor-actions .action-item:has(.codicon-lock),
+.monaco-workbench.phone-layout .part.titlebar .window-controls-container,
+.monaco-workbench.phone-layout .part.titlebar .layout-controls {
+	display: none !important;
+}
+
+.monaco-workbench.phone-layout .monaco-breadcrumbs .monaco-breadcrumb-item:not(:last-child) {
+	display: none !important;
+}
+
+/* 3. Hide status bar noise on small viewports */
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.workspaceTrust"],
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.feedback"],
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.liveShare"],
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.editor.encoding"],
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.editor.eol"],
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.editor.indentation"],
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.tweet"],
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item[id*="status.telemetry"] {
+	display: none !important;
+}
+
+.monaco-workbench.phone-layout .part.statusbar .statusbar-item {
+	padding: 0 6px;
+}
+
+/* 4. Hide desktop context menu side actions */
+.monaco-workbench.phone-layout .context-view .action-item:has(.action-label[aria-label*="Open to the Side"]),
