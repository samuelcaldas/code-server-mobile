+	const width = Math.min(360, Math.floor(bounds.width * 0.9));
+	const left = part === Parts.AUXILIARYBAR_PART ? bounds.left + bounds.width - width : bounds.left;
+	return { top: bounds.top, left, width, height: bounds.height };
