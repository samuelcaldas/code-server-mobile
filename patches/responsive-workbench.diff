+ *--------------------------------------------------------------------------------------------*/
+
+/*
+ * Compact workbench layout.
+ *
+ * Every rule is scoped to `.monaco-workbench.phone-layout`, which is applied
+ * by `Layout#updateViewportClass` only while the container geometry needs the
+ * single-pane phone topology. Other viewport classes remain untouched.
+ *
+ * Rule shape follows `vs/sessions/browser/media/phoneLayout.css`, which is the
+ * production phone layout for the Agent Sessions workbench.
+ */
+
+/* ---- Phone Layout: Overscroll Containment ---- */
+
+/*
+ * Keeps a scroll gesture inside the list or editor it started in, rather than
+ * chaining to the document and bouncing the whole workbench.
+ */
+.monaco-workbench.phone-layout .monaco-scrollable-element > .scrollable-element,
+.monaco-workbench.phone-layout .monaco-list {
+	overscroll-behavior: contain;
+}
+
+/* ---- Phone Layout: Touch Targets ---- */
+
+/*
+ * Coarse pointers need a larger hit area than the desktop density provides.
+ * 44px is the smallest comfortably tappable target on a phone; the spacing
+ * ramp has no token for it because it is an accessibility floor, not spacing.
+ */
+.monaco-workbench.phone-layout .action-item > .action-label {
+	min-height: 44px;
+	min-width: 44px;
+}
+
+/*
+ * Exceptions. The status bar is a fixed-height strip and the quick input and
+ * editor toolbars are dense by design; growing them costs more content than
+ * the larger target buys.
+ */
+.monaco-workbench.phone-layout .part.statusbar .action-item > .action-label,
+.monaco-workbench.phone-layout .quick-input-widget .action-item > .action-label,
+.monaco-workbench.phone-layout .editor-actions .action-item > .action-label {
+	min-height: 0;
+	min-width: 0;
+}
+
+.monaco-workbench.phone-layout .part.activitybar .menubar,
+.monaco-workbench.phone-layout .part.activitybar .menubar.compact .toolbar-toggle-more {
+	height: 44px;
+}
+
+.monaco-workbench.phone-layout .action-item,
+.monaco-workbench.phone-layout button {
+	/* Opts out of double-tap-to-zoom so taps register without waiting. */
+	touch-action: manipulation;
+}
+
+.monaco-workbench.phone-layout .action-item,
+.monaco-workbench.phone-layout .monaco-toolbar {
+	-webkit-touch-callout: none;
+	user-select: none;
+	-webkit-user-select: none;
+}
+
+/* ---- Phone Layout: Quick Picks ---- */
+
+.monaco-workbench.phone-layout .quick-input-widget {
+	left: 8px !important;
+	right: 8px !important;
+	width: auto !important;
+	max-width: none !important;
+}
+
+/*
+ * A picker that grows past half the viewport leaves no room for the on-screen
+ * keyboard, which is what the user is typing the filter with.
+ */
+.monaco-workbench.phone-layout .quick-input-widget .quick-input-list,
+.monaco-workbench.phone-layout .quick-input-widget .quick-input-tree,
+.monaco-workbench.phone-layout .quick-input-widget .quick-input-list .monaco-list,
+.monaco-workbench.phone-layout .quick-input-widget .quick-input-tree .monaco-list {
+	max-height: min(50vh, var(--vscode-visible-viewport-half-height, 50vh)) !important;
+}
+
+.monaco-workbench.phone-layout .quick-input-widget .quick-input-list .monaco-list-row,
+.monaco-workbench.phone-layout .quick-input-widget .quick-input-tree .monaco-list-row {
+	min-height: 44px;
+}
+
+/* ---- Phone Layout: Title Bar ---- */
+
+/*
+ * Go Back / Go Forward duplicate browser history and rarely have anywhere
+ * useful to go from a single-pane phone session. Keep the Command Center
+ * down to the one thing that is useful here: the search / quick-open pill.
+ */
+.monaco-workbench.phone-layout .part.titlebar .command-center > .monaco-toolbar > .monaco-action-bar > .actions-container > .action-item:not(.command-center-center) {
+	display: none;
+}
+
+/*
