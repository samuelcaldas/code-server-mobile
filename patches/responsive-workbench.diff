+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../base/test/common/utils.js';
+import { WorkbenchViewportPolicy } from '../../browser/viewportPolicy.js';
+
+suite('WorkbenchViewportPolicy', () => {
+
+	const disposables = ensureNoDisposablesAreLeakedInTestSuite();
+
+	function createPolicy(): WorkbenchViewportPolicy {
+		return disposables.add(new WorkbenchViewportPolicy());
+	}
+
+	test('classifies portrait, landscape, tablet and desktop geometry', () => {
+		const policy = createPolicy();
+
+		policy.update(390, 844);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(844, 390);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(800, 600);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(1280, 800);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop');
+	});
+
+	test('treats geometry breakpoints as exclusive upper bounds', () => {
+		const policy = createPolicy();
+
+		policy.update(639, 844);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(640, 844);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(959, 479);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(960, 479);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(959, 480);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(1023, 800);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(1024, 800);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop');
+	});
+
+	test('classifies on geometry alone, independently of the user agent', () => {
+		// Samsung DeX keeps the Android user agent while presenting a large
+		// display, so geometry must decide the topology regardless of the device
+		// the browser reports.
+		const policy = createPolicy();
+
+		policy.update(360, 800);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(1920, 1080);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop');
+	});
+
+	test('ignores invalid geometry', () => {
+		const policy = createPolicy();
+		policy.update(390, 844);
+
+		assert.strictEqual(policy.update(0, 844), false);
+		assert.strictEqual(policy.update(390, 0), false);
+		assert.strictEqual(policy.update(Number.NaN, 844), false);
+		assert.strictEqual(policy.update(390, Number.POSITIVE_INFINITY), false);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+	});
+
+	test('isPhoneLayout tracks the viewport class', () => {
+		const policy = createPolicy();
+
+		policy.update(390, 844);
+		assert.strictEqual(policy.isPhoneLayout.get(), true);
+
+		policy.update(1280, 800);
+		assert.strictEqual(policy.isPhoneLayout.get(), false);
+	});
+
+	test('update reports whether the classification changed', () => {
+		const policy = createPolicy();
+
+		assert.strictEqual(policy.update(390, 844), true, 'desktop to phone is a change');
+		assert.strictEqual(policy.update(400, 800), false, 'still phone');
+		assert.strictEqual(policy.update(1280, 800), true, 'phone to desktop is a change');
+	});
+
+	test('hides sidebar, auxiliary bar and panel by default on phone', () => {
+		const policy = createPolicy();
+		policy.update(390, 844);
+
+		assert.deepStrictEqual(policy.getPartVisibilityDefaults(), {
+			sidebar: false,
+			auxiliaryBar: false,
+			panel: false,
+		});
+	});
+
+	test('keeps the sidebar visible by default on desktop', () => {
+		const policy = createPolicy();
+		policy.update(1280, 800);
+
+		assert.strictEqual(policy.getPartVisibilityDefaults().sidebar, true);
+	});
+
+	test('override pins the classification and can be cleared', () => {
+		const policy = createPolicy();
+		policy.update(1280, 800);
+
+		policy.setOverride('phone');
+		assert.strictEqual(policy.viewportClass.get(), 'phone', 'override wins over geometry');
+
+		policy.update(1920, 1080);
+		assert.strictEqual(policy.viewportClass.get(), 'phone', 'override survives layout passes');
+
+		policy.setOverride(undefined);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop', 'clearing restores geometry classification');
+	});
+});
