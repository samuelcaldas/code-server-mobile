+		const visualViewport = { offsetTop: 0, offsetLeft: 0, width: 390, height: 460 };
+
+		assert.deepStrictEqual(getVisibleViewportBounds(editorBounds, visualViewport), {
+			top: 35,
+			left: 48,
+			width: 342,
+			height: 425,
+		});
+	});
+
+	test('accounts for a panned visual viewport', () => {
+		const visualViewport = { offsetTop: 100, offsetLeft: 20, width: 350, height: 400 };
+
+		assert.deepStrictEqual(getVisibleViewportBounds(editorBounds, visualViewport), {
+			top: 100,
+			left: 48,
+			width: 322,
+			height: 400,
+		});
+	});
+
+	test('never expands beyond editor bounds', () => {
+		const visualViewport = { offsetTop: 0, offsetLeft: 0, width: 1280, height: 900 };
+
+		assert.deepStrictEqual(getVisibleViewportBounds(editorBounds, visualViewport), editorBounds);
+	});
+
+	test('ignores invalid visual viewport geometry', () => {
+		const visualViewport = { offsetTop: 0, offsetLeft: 0, width: Number.NaN, height: 460 };
