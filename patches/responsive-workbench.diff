+import { addDisposableListener, EventType, getWindow } from '../../base/browser/dom.js';
+import { Disposable } from '../../base/common/lifecycle.js';
+
+const VISIBLE_VIEWPORT_HEIGHT = '--vscode-visible-viewport-height';
+const VISIBLE_VIEWPORT_HALF_HEIGHT = '--vscode-visible-viewport-half-height';
+const KEYBOARD_HEIGHT = '--vscode-keyboard-height';
+
+export interface IViewportBounds {
+	readonly top: number;
+	readonly left: number;
+	readonly width: number;
+	readonly height: number;
+}
+
+export interface IVisualViewportGeometry {
+	readonly offsetTop: number;
+	readonly offsetLeft: number;
+	readonly width: number;
+	readonly height: number;
+	readonly scale?: number;
+}
+
+/** Tracks visible browser geometry without changing workbench topology. */
+export class WorkbenchVisibleViewport extends Disposable {
+
+	private readonly targetWindow: Window;
+
+	constructor(
+		private readonly container: HTMLElement,
+		private readonly onDidChange: () => void,
+		targetWindow = getWindow(container)
+	) {
+		super();
+		this.targetWindow = targetWindow;
+		this.registerListeners();
+		this.update();
+	}
+
+	getBounds(bounds: IViewportBounds): IViewportBounds {
+		return getVisibleViewportBounds(bounds, this.getVisualViewport());
+	}
+
+	private registerListeners(): void {
+		const visualViewport = this.targetWindow.visualViewport;
+		if (!visualViewport) {
+			return;
+		}
+
+		this._register(addDisposableListener(visualViewport, EventType.RESIZE, () => this.update()));
+		this._register(addDisposableListener(visualViewport, EventType.SCROLL, () => this.update()));
+	}
+
+	private update(): void {
+		const visualViewport = this.getVisualViewport();
+		if (!visualViewport || !hasValidViewportGeometry(visualViewport)) {
+			this.clearStyles();
+			this.onDidChange();
+			return;
+		}
+
+		this.publishStyles(visualViewport);
+		this.onDidChange();
+	}
+
+	private getVisualViewport(): IVisualViewportGeometry | undefined {
+		return this.targetWindow.visualViewport ?? undefined;
+	}
+
+	private publishStyles(visualViewport: IVisualViewportGeometry): void {
+		const keyboardHeight = getKeyboardHeight(this.targetWindow.innerHeight, visualViewport);
+		this.container.style.setProperty(VISIBLE_VIEWPORT_HEIGHT, `${visualViewport.height}px`);
+		this.container.style.setProperty(VISIBLE_VIEWPORT_HALF_HEIGHT, `${visualViewport.height / 2}px`);
+		this.container.style.setProperty(KEYBOARD_HEIGHT, `${keyboardHeight}px`);
+	}
+
+	private clearStyles(): void {
+		this.container.style.removeProperty(VISIBLE_VIEWPORT_HEIGHT);
+		this.container.style.removeProperty(VISIBLE_VIEWPORT_HALF_HEIGHT);
+		this.container.style.removeProperty(KEYBOARD_HEIGHT);
+	}
+
+	override dispose(): void {
+		this.clearStyles();
+		super.dispose();
+	}
+}
+
+/**
+ * Intersects `getBoundingClientRect()` bounds with visual-viewport offsets in
+ * their shared layout CSS coordinate space.
+ */
+export function getVisibleViewportBounds(
+	bounds: IViewportBounds,
+	visualViewport?: IVisualViewportGeometry
+): IViewportBounds {
+	if (!hasValidBounds(bounds) || !visualViewport || !hasValidViewportGeometry(visualViewport)) {
+		return bounds;
+	}
+
+	const left = Math.max(bounds.left, visualViewport.offsetLeft);
+	const top = Math.max(bounds.top, visualViewport.offsetTop);
+	const right = Math.min(getRight(bounds), visualViewport.offsetLeft + visualViewport.width);
+	const bottom = Math.min(getBottom(bounds), visualViewport.offsetTop + visualViewport.height);
+	return { top, left, width: Math.max(0, right - left), height: Math.max(0, bottom - top) };
+}
+
+function getKeyboardHeight(innerHeight: number, viewport: IVisualViewportGeometry): number {
+	// Pinch zoom shrinks the visual viewport without introducing a keyboard.
+	if (viewport.scale !== undefined && viewport.scale !== 1) {
+		return 0;
+	}
+
+	const visibleBottom = viewport.offsetTop + viewport.height;
+	return Math.max(0, innerHeight - visibleBottom);
+}
+
+function hasValidBounds(bounds: IViewportBounds): boolean {
+	return [bounds.top, bounds.left, bounds.width, bounds.height].every(Number.isFinite) &&
+		bounds.width >= 0 && bounds.height >= 0;
+}
+
+function hasValidViewportGeometry(viewport: IVisualViewportGeometry): boolean {
+	return hasValidBounds({
+		top: viewport.offsetTop,
+		left: viewport.offsetLeft,
+		width: viewport.width,
+		height: viewport.height,
+	}) && viewport.width > 0 && viewport.height > 0;
+}
+
+function getRight(bounds: IViewportBounds): number {
+	return bounds.left + bounds.width;
+}
+
+function getBottom(bounds: IViewportBounds): number {
+	return bounds.top + bounds.height;
+}
