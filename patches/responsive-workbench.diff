+	if (part === Parts.SIDEBAR_PART) {
+		return 'mobile-navigation-overlay--sidebar';
+	}
+	if (part === Parts.AUXILIARYBAR_PART) {
+		return 'mobile-navigation-overlay--auxiliarybar';
+	}
+	return 'mobile-navigation-overlay--panel';
+}
+
+function getOverlayGeometry(part: Parts, bounds: IViewportBounds): IOverlayGeometry {
+	if (part === Parts.PANEL_PART) {
+		const height = Math.min(480, Math.floor(bounds.height * 0.6));
+		return { top: bounds.top + bounds.height - height, left: bounds.left, width: bounds.width, height };
