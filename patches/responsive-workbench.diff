+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../base/test/common/utils.js';
+import { WorkbenchViewportPolicy } from '../../browser/viewportPolicy.js';
+
+suite('WorkbenchViewportPolicy', () => {
+
+	const disposables = ensureNoDisposablesAreLeakedInTestSuite();
+
+	function createPolicy(): WorkbenchViewportPolicy {
+		return disposables.add(new WorkbenchViewportPolicy());
+	}
+
+	test('classifies widths into phone, tablet and desktop', () => {
+		const policy = createPolicy();
+
+		policy.update(390);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(800);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(1280);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop');
+	});
+
+	test('treats the breakpoints as exclusive upper bounds', () => {
+		const policy = createPolicy();
+
+		policy.update(639);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(640);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(1023);
+		assert.strictEqual(policy.viewportClass.get(), 'tablet');
+
+		policy.update(1024);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop');
+	});
+
+	test('classifies on width alone, independently of the user agent', () => {
+		// Samsung DeX keeps the Android user agent while presenting a large
+		// display, so a narrow viewport must classify as phone and a wide one
+		// as desktop regardless of the device the browser reports.
+		const policy = createPolicy();
+
+		policy.update(360);
+		assert.strictEqual(policy.viewportClass.get(), 'phone');
+
+		policy.update(1920);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop');
+	});
+
+	test('isPhoneLayout tracks the viewport class', () => {
+		const policy = createPolicy();
+
+		policy.update(390);
+		assert.strictEqual(policy.isPhoneLayout.get(), true);
+
+		policy.update(1280);
+		assert.strictEqual(policy.isPhoneLayout.get(), false);
+	});
+
+	test('update reports whether the classification changed', () => {
+		const policy = createPolicy();
+
+		assert.strictEqual(policy.update(390), true, 'desktop to phone is a change');
+		assert.strictEqual(policy.update(400), false, 'still phone');
+		assert.strictEqual(policy.update(1280), true, 'phone to desktop is a change');
+	});
+
+	test('hides sidebar, auxiliary bar and panel by default on phone', () => {
+		const policy = createPolicy();
+		policy.update(390);
+
+		assert.deepStrictEqual(policy.getPartVisibilityDefaults(), {
+			sidebar: false,
+			auxiliaryBar: false,
+			panel: false,
+		});
+	});
+
+	test('keeps the sidebar visible by default on desktop', () => {
+		const policy = createPolicy();
+		policy.update(1280);
+
+		assert.strictEqual(policy.getPartVisibilityDefaults().sidebar, true);
+	});
+
+	test('override pins the classification and can be cleared', () => {
+		const policy = createPolicy();
+		policy.update(1280);
+
+		policy.setOverride('phone');
+		assert.strictEqual(policy.viewportClass.get(), 'phone', 'override wins over width');
+
+		policy.update(1920);
+		assert.strictEqual(policy.viewportClass.get(), 'phone', 'override survives layout passes');
+
+		policy.setOverride(undefined);
+		assert.strictEqual(policy.viewportClass.get(), 'desktop', 'clearing restores width classification');
+	});
+});
