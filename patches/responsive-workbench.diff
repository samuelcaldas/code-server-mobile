+
+import { Disposable } from '../../base/common/lifecycle.js';
+import { derived, IObservable, observableValue } from '../../base/common/observable.js';
+
+/** Viewport classification based on container geometry. */
+export type ViewportClass = 'phone' | 'tablet' | 'desktop';
+
+/** Default visibility for each workbench part. */
+export interface IPartVisibilityDefaults {
+	readonly sidebar: boolean;
+	readonly auxiliaryBar: boolean;
+	readonly panel: boolean;
+}
+
+/**
+ * CSS class applied to the workbench container while the viewport is
+ * classified as `phone`. Stylesheets key compact rules off this class so that
+ * desktop rendering is untouched.
+ */
+export const PHONE_LAYOUT_CLASS = 'phone-layout';
+
+const PHONE_MAX_WIDTH = 640;
+const PHONE_LANDSCAPE_MAX_WIDTH = 960;
+const PHONE_LANDSCAPE_MAX_HEIGHT = 480;
+const TABLET_MAX_WIDTH = 1024;
+
+/**
+ * Viewport classification for the workbench.
+ *
+ * Classification is driven purely by container geometry, deliberately without
+ * consulting the user agent. code-server runs the workbench in a browser on
+ * hardware it cannot identify: a phone in portrait or landscape, a narrow
+ * desktop window, and a Samsung DeX session (which keeps the Android user
+ * agent while presenting a large external display) must all resolve from the
+ * same live signal. The ordinary `layout()` pass observes that geometry, so
+ * plugging or unplugging DeX, rotating, or resizing re-classifies with no
+ * reload.
+ *
+ * The object is intentionally free of service dependencies so it can be unit
+ * tested directly.
+ */
+export class WorkbenchViewportPolicy extends Disposable {
+
+	private readonly _viewportClass = observableValue<ViewportClass>(this, 'desktop');
+
+	/** Current viewport class, derived from the most recent `update()`. */
+	readonly viewportClass: IObservable<ViewportClass> = this._viewportClass;
+
+	/** `true` while the viewport class is `phone`. */
+	readonly isPhoneLayout: IObservable<boolean> = derived(this, reader => {
+		return this._viewportClass.read(reader) === 'phone';
+	});
+
+	private _override: ViewportClass | undefined;
+	private _lastWidth = 0;
+	private _lastHeight = 0;
+
+	/**
+	 * Pins the classification, ignoring geometry. Pass `undefined` to restore
+	 * automatic classification. Reserved for a future user-facing override.
+	 */
+	setOverride(viewportClass: ViewportClass | undefined): void {
+		this._override = viewportClass;
+		this.update(this._lastWidth, this._lastHeight);
+	}
+
+	/**
+	 * Re-classify for the given container geometry. Call from the workbench
+	 * `layout()` pass. Returns `true` when the classification changed.
+	 */
+	update(width: number, height: number): boolean {
+		const validGeometry = hasValidGeometry(width, height);
+		if (validGeometry) {
+			this._lastWidth = width;
+			this._lastHeight = height;
+		}
+
+		const next = this._override ?? (validGeometry ? classifyViewport(width, height) : undefined);
+		if (!next || this._viewportClass.get() === next) {
+			return false;
+		}
+
+		this._viewportClass.set(next, undefined);
+		return true;
+	}
+
+	/** Default part visibility for the current (or given) viewport class. */
+	getPartVisibilityDefaults(viewportClass?: ViewportClass): IPartVisibilityDefaults {
+		const current = viewportClass ?? this._viewportClass.get();
+		if (current === 'phone') {
+			// Compact mode gives the whole viewport to the editor. Navigation can
+			// present transient surfaces without persisting them as desktop splits.
+			return { sidebar: false, auxiliaryBar: false, panel: false };
+		}
+
+		return { sidebar: true, auxiliaryBar: false, panel: false };
+	}
+}
+
+/** Classifies valid container geometry into a viewport class. */
+function classifyViewport(width: number, height: number): ViewportClass {
+	if (width < PHONE_MAX_WIDTH) {
+		return 'phone';
+	}
+
+	if (width < PHONE_LANDSCAPE_MAX_WIDTH && height < PHONE_LANDSCAPE_MAX_HEIGHT) {
+		return 'phone';
+	}
+
+	if (width < TABLET_MAX_WIDTH) {
+		return 'tablet';
+	}
+
+	return 'desktop';
+}
+
+function hasValidGeometry(width: number, height: number): boolean {
+	return Number.isFinite(width) && width > 0 && Number.isFinite(height) && height > 0;
+}
